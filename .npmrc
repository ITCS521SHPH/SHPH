registry=https://registry.npmjs.org/
package-lock=true
prefer-offline=false
audit=false

# Registry fallbacks and settings for reliability
@radix-ui:registry=https://registry.npmjs.org/
@types:registry=https://registry.npmjs.org/
@hookform:registry=https://registry.npmjs.org/
@supabase:registry=https://registry.npmjs.org/
@vercel:registry=https://registry.npmjs.org/

# Retry settings for flaky connections
fetch-retries=5
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Connection timeout settings
fetch-timeout=120000
timeout=120000

# SSL and networking
strict-ssl=true
ca=null
# cafile=null